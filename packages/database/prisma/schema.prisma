generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MARKETING_MANAGER
  CONTENT_MANAGER
  DESIGNER
  ANALYST
  APPROVER
  VIEWER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  SOFT_DELETED
}

enum OnboardingStatus {
  DRAFT
  GENERATING
  ACTIVE
}

enum PlanTier {
  STARTER
  GROWTH
  SCALE
}

enum PlatformRole {
  OWNER
  SUPPORT
}

model Organization {
  id             String             @id @default(cuid())
  name           String
  slug           String             @unique
  status         OrganizationStatus @default(ACTIVE)
  planTier       PlanTier           @default(STARTER)
  limitOverrides Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  members               OrganizationMember[]
  brands                Brand[]
  brandProducts         BrandProduct[]
  brandCompetitors      BrandCompetitor[]
  auditLogs             AuditLog[]
  sessions              Session[]
  brandAssets           BrandAsset[]
  featureFlags          FeatureFlag[]
  impersonationSessions ImpersonationSession[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships           OrganizationMember[]
  auditLogs             AuditLog[]
  sessions              Session[]
  impersonationSessions ImpersonationSession[]
}

model Session {
  id                   String   @id @default(cuid())
  userId               String
  sessionToken         String   @unique
  activeOrganizationId String?
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           Role
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Brand {
  id               String           @id @default(cuid())
  organizationId   String
  name             String
  industry         String?
  websiteUrl       String?
  targetAudience   String?
  geography        String?
  priceSegment     String?
  positioning      String?
  usp              String?
  onboardingStatus OnboardingStatus @default(DRAFT)
  onboardingStep   Int              @default(1)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets       BrandAsset[]
  products     BrandProduct[]
  competitors  BrandCompetitor[]

  @@index([organizationId])
}

model BrandProduct {
  id             String   @id @default(cuid())
  brandId        String
  organizationId String
  name           String
  description    String?
  type           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([organizationId])
}

model BrandCompetitor {
  id             String   @id @default(cuid())
  brandId        String
  organizationId String
  name           String
  websiteUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model BrandAsset {
  id               String            @id @default(cuid())
  organizationId   String
  brandId          String
  type             String
  url              String
  fileName         String?
  mimeType         String?
  size             Int?
  extractionStatus ExtractionStatus?
  extractedText    String?
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([brandId])
}

model PlatformAdmin {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String?
  totpSecret   String?
  name         String?
  role         PlatformRole @default(SUPPORT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sessions              PlatformSession[]
  auditLogs             PlatformAuditLog[]
  impersonationSessions ImpersonationSession[]
}

model PlatformSession {
  id              String   @id @default(cuid())
  platformAdminId String
  sessionToken    String   @unique
  ipAddress       String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId])
  @@index([sessionToken])
}

model ImpersonationSession {
  id                   String    @id @default(cuid())
  platformAdminId      String
  targetUserId         String
  targetOrganizationId String
  sessionToken         String    @unique
  readOnly             Boolean   @default(true)
  expiresAt            DateTime
  createdAt            DateTime  @default(now())
  endedAt              DateTime?

  platformAdmin      PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)
  targetUser         User          @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  targetOrganization Organization  @relation(fields: [targetOrganizationId], references: [id], onDelete: Cascade)

  @@index([platformAdminId])
  @@index([targetUserId])
  @@index([targetOrganizationId])
  @@index([sessionToken])
}

model PlatformAuditLog {
  id              String   @id @default(cuid())
  platformAdminId String
  action          String
  entityType      String
  entityId        String
  metadata        Json?
  createdAt       DateTime @default(now())

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model FeatureFlag {
  id             String   @id @default(cuid())
  organizationId String
  flagName       String
  enabled        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, flagName])
  @@index([organizationId])
}
