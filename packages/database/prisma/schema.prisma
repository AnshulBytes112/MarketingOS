generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MARKETING_MANAGER
  CONTENT_MANAGER
  DESIGNER
  ANALYST
  APPROVER
  VIEWER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  SOFT_DELETED
}

enum OnboardingStatus {
  DRAFT
  GENERATING
  ACTIVE
}

enum BrandDNAStatus {
  GENERATING
  COMPLETED
  FAILED
}

enum BrandDNAPublicationStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

enum PlanTier {
  STARTER
  GROWTH
  SCALE
}

enum PlatformRole {
  OWNER
  SUPPORT
}

model Organization {
  id             String             @id @default(cuid())
  name           String
  slug           String             @unique
  status         OrganizationStatus @default(ACTIVE)
  planTier       PlanTier           @default(STARTER)
  limitOverrides Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  members               OrganizationMember[]
  brands                Brand[]
  brandProducts         BrandProduct[]
  brandCompetitors      BrandCompetitor[]
  competitorAccounts    CompetitorAccount[]
  competitorPosts       CompetitorPost[]
  aiRecommendations     AIRecommendation[]
  auditLogs             AuditLog[]
  sessions              Session[]
  brandAssets           BrandAsset[]
  featureFlags          FeatureFlag[]
  impersonationSessions ImpersonationSession[]
  dnaVersions           BrandDNAVersion[]
  dnaEdits              BrandDNAEdit[]
  aiUsage               AIUsage[]
  strategies            Strategy[]
  strategyEdits         StrategyEdit[]
  contentPlans          ContentPlan[]
  contentItems          ContentItem[]
  contentChannels       ContentChannel[]
  contentGenerations    ContentGeneration[]
  generatedAssets       GeneratedAsset[]
  approvals             Approval[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships           OrganizationMember[]
  auditLogs             AuditLog[]
  sessions              Session[]
  impersonationSessions ImpersonationSession[]
  dnaVersionsCreated    BrandDNAVersion[]      @relation("DNAVersionCreator")
  dnaEdits              BrandDNAEdit[]
  strategiesCreated     Strategy[]             @relation("StrategyCreator")
  strategiesApproved    Strategy[]             @relation("StrategyApprover")
  strategyEdits         StrategyEdit[]
  approvalsRequested    Approval[]             @relation("ApprovalRequestedBy")
  approvalsReviewed     Approval[]             @relation("ApprovalReviewedBy")
}

model Session {
  id                   String   @id @default(cuid())
  userId               String
  sessionToken         String   @unique
  activeOrganizationId String?
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

enum MemberStatus {
  ACTIVE
  DEACTIVATED
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           Role
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}


model Brand {
  id               String           @id @default(cuid())
  organizationId   String
  name             String
  industry         String?
  websiteUrl       String?
  targetAudience   String?
  geography        String?
  priceSegment     String?
  positioning      String?
  usp              String?
  onboardingStatus OnboardingStatus @default(DRAFT)
  onboardingStep   Int              @default(1)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets             BrandAsset[]
  products           BrandProduct[]
  competitors        BrandCompetitor[]
  competitorAccounts CompetitorAccount[]
  competitorPosts    CompetitorPost[]
  aiRecommendations  AIRecommendation[]
  dnaVersions        BrandDNAVersion[]
  dnaEdits           BrandDNAEdit[]
  aiUsage            AIUsage[]
  strategies         Strategy[]
  strategyEdits      StrategyEdit[]
  contentPlans       ContentPlan[]
  contentItems       ContentItem[]
  contentChannels    ContentChannel[]
  contentGenerations ContentGeneration[]
  generatedAssets    GeneratedAsset[]
  approvals          Approval[]

  @@index([organizationId])
}

model BrandProduct {
  id             String   @id @default(cuid())
  brandId        String
  organizationId String
  name           String
  description    String?
  type           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([organizationId])
}

model BrandCompetitor {
  id             String   @id @default(cuid())
  brandId        String
  organizationId String
  name           String
  websiteUrl     String?
  instagram      String?
  facebook       String?
  linkedin       String?
  twitter        String?
  youtube        String?
  tiktok         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  accounts        CompetitorAccount[]
  posts           CompetitorPost[]
  recommendations AIRecommendation[]

  @@index([brandId])
  @@index([organizationId])
}

model CompetitorAccount {
  id             String    @id @default(cuid())
  organizationId String
  brandId        String
  competitorId   String
  platform       String
  handle         String
  profileUrl     String?
  displayName    String?
  bio            String?
  followerCount  Int?
  followingCount Int?
  postCount      Int?
  lastSyncedAt   DateTime?
  syncStatus     String
  sourceType     String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  brand        Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  competitor   BrandCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  posts CompetitorPost[]

  @@unique([organizationId, competitorId, platform])
  @@index([brandId])
  @@index([organizationId])
  @@index([competitorId])
}

model CompetitorPost {
  id                  String   @id @default(cuid())
  organizationId      String
  brandId             String
  competitorId        String
  competitorAccountId String
  platform            String
  externalPostId      String?
  url                 String?
  publishedAt         DateTime
  captionText         String?
  mediaType           String?
  likeCount           Int?
  commentCount        Int?
  shareCount          Int?
  viewCount           Int?
  engagementRate      Float?
  collectedAt         DateTime @default(now())
  sourceType          String
  rawMetadata         Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  brand             Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  competitor        BrandCompetitor   @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  competitorAccount CompetitorAccount @relation(fields: [competitorAccountId], references: [id], onDelete: Cascade)

  @@unique([organizationId, competitorAccountId, externalPostId])
  @@index([brandId])
  @@index([organizationId])
  @@index([competitorId])
  @@index([competitorAccountId])
}

model AIRecommendation {
  id             String   @id @default(cuid())
  organizationId String
  brandId        String
  competitorId   String
  type           String
  observation    String
  likelyCause    String
  recommendation String
  action         String
  confidence     Float
  sources        Json
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brand        Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  competitor   BrandCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([organizationId])
  @@index([competitorId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model BrandAsset {
  id               String            @id @default(cuid())
  organizationId   String
  brandId          String
  type             String
  url              String
  fileName         String?
  mimeType         String?
  size             Int?
  extractionStatus ExtractionStatus?
  extractedText    String?
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([brandId])
}

model BrandDNAVersion {
  id                    String                    @id @default(cuid())
  organizationId        String
  brandId               String
  version               Int
  status                BrandDNAStatus            @default(GENERATING)
  publicationStatus     BrandDNAPublicationStatus @default(DRAFT)
  source                String                    @default("AI_GENERATION")
  restoredFromVersionId String?
  personality           String?
  voice                 String?
  tone                  String?
  positioning           String?
  visualIdentitySummary String?
  audience              String?
  demographics          Json?
  contentPillars        Json?
  language              String?
  ctaPreferences        String?
  avoidList             Json?
  claims                Json?
  constraints           Json?
  confidenceScore       Int?
  sources               Json?
  createdAt             DateTime                  @default(now())
  completedAt           DateTime?
  createdById           String?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy    User?          @relation("DNAVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  edits        BrandDNAEdit[]

  @@index([organizationId])
  @@index([brandId])
}

model BrandDNAEdit {
  id                String   @id @default(cuid())
  organizationId    String
  brandId           String
  brandDNAVersionId String
  userId            String
  field             String
  previousValue     String? // Stored as JSON string
  newValue          String? // Stored as JSON string
  source            String   @default("MANUAL_EDIT")
  requestId         String?
  createdAt         DateTime @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand           Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandDNAVersion BrandDNAVersion @relation(fields: [brandDNAVersionId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([brandDNAVersionId])
}

model AIUsage {
  id             String   @id @default(cuid())
  organizationId String
  brandId        String
  requestId      String
  provider       String
  model          String
  inputTokens    Int
  outputTokens   Int
  totalTokens    Int
  estimatedCost  Float?
  latencyMs      Int
  status         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([brandId])
  @@index([requestId])
}

model PlatformAdmin {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String?
  totpSecret   String?
  name         String?
  role         PlatformRole @default(SUPPORT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sessions              PlatformSession[]
  auditLogs             PlatformAuditLog[]
  impersonationSessions ImpersonationSession[]
}

model PlatformSession {
  id              String   @id @default(cuid())
  platformAdminId String
  sessionToken    String   @unique
  ipAddress       String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId])
  @@index([sessionToken])
}

model ImpersonationSession {
  id                   String    @id @default(cuid())
  platformAdminId      String
  targetUserId         String
  targetOrganizationId String
  sessionToken         String    @unique
  readOnly             Boolean   @default(true)
  expiresAt            DateTime
  createdAt            DateTime  @default(now())
  endedAt              DateTime?

  platformAdmin      PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)
  targetUser         User          @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  targetOrganization Organization  @relation(fields: [targetOrganizationId], references: [id], onDelete: Cascade)

  @@index([platformAdminId])
  @@index([targetUserId])
  @@index([targetOrganizationId])
  @@index([sessionToken])
}

model PlatformAuditLog {
  id              String   @id @default(cuid())
  platformAdminId String
  action          String
  entityType      String
  entityId        String
  metadata        Json?
  createdAt       DateTime @default(now())

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model FeatureFlag {
  id             String   @id @default(cuid())
  organizationId String
  flagName       String
  enabled        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, flagName])
  @@index([organizationId])
}

model Strategy {
  id                String                    @id @default(cuid())
  organizationId    String
  brandId           String
  version           Int
  status            String // "GENERATING", "COMPLETED", "FAILED"
  publicationStatus StrategyPublicationStatus @default(DRAFT)
  source            String                    @default("AI_GENERATION")
  createdById       String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  completedAt       DateTime?

  // Structured fields
  goal                  Json?
  audienceSegments      Json?
  contentPillars        Json?
  contentMix            Json?
  funnelMapping         Json?
  platformStrategy      Json?
  formats               Json?
  cadence               Json?
  themes                Json?
  campaignOpportunities Json?
  reasoning             Json?
  sources               Json?
  dataLimitations       Json?
  experiments           Json?

  approvalStatus StrategyApprovalStatus @default(PENDING)
  approvedAt     DateTime?
  approvedById   String?
  lockedAt       DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy    User?          @relation("StrategyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy   User?          @relation("StrategyApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  edits        StrategyEdit[]
  contentPlans ContentPlan[]
  contentItems ContentItem[]

  @@index([organizationId])
  @@index([brandId])
}

enum StrategyApprovalStatus {
  PENDING
  APPROVED
}

enum ContentPlanStatus {
  GENERATING
  COMPLETED
  FAILED
}

enum ContentItemStatus {
  DRAFT
  READY_FOR_REVIEW
  SCHEDULED
  PUBLISHED
}

model ContentPlan {
  id             String            @id @default(cuid())
  organizationId String
  brandId        String
  strategyId     String
  status         ContentPlanStatus @default(GENERATING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  strategy     Strategy      @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  contentItems ContentItem[]

  @@index([organizationId])
  @@index([brandId])
  @@index([strategyId])
}

model ContentItem {
  id             String            @id
  organizationId String
  brandId        String
  contentPlanId  String
  strategyId       String
  contentChannelId String?
  title            String
  platform         String
  type           String?
  format         String
  scheduledDate  DateTime
  funnelStage    String
  contentPillar  String
  theme          String?
  hook           String?
  cta            String?
  campaign       String?
  aiScore        Float?
  reason         String?
  source         String            @default("AI_GENERATION")
  version        Int               @default(1)
  status         ContentItemStatus @default(DRAFT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentPlan  ContentPlan     @relation(fields: [contentPlanId], references: [id], onDelete: Cascade)
  strategy     Strategy        @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  channel      ContentChannel? @relation(fields: [contentChannelId], references: [id], onDelete: SetNull)

  generations  ContentGeneration[]
  approvals    Approval[]

  @@index([organizationId])
  @@index([brandId])
  @@index([contentPlanId])
  @@index([strategyId])
  @@index([contentChannelId])
  @@index([scheduledDate])
}

enum StrategyPublicationStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

model StrategyEdit {
  id               String   @id @default(cuid())
  organizationId   String
  brandId          String
  strategyId       String
  userId           String
  recommendationId String?
  field            String
  previousValue    Json?
  newValue         Json?
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  strategy     Strategy     @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([strategyId])
}

model ContentChannel {
  id             String   @id @default(cuid())
  organizationId String
  brandId        String
  type           String
  platform       String
  name           String
  handle         String?
  url            String?
  isActive       Boolean  @default(true)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand          Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentItems   ContentItem[]

  @@index([organizationId])
  @@index([brandId])
}

model ContentGeneration {
  id               String   @id @default(cuid())
  organizationId   String
  brandId          String
  contentItemId    String
  version          Int      @default(1)
  
  textStatus       GenerationStatus @default(NOT_CONFIGURED)
  imageStatus      GenerationStatus @default(NOT_CONFIGURED)
  videoStatus      GenerationStatus @default(NOT_CONFIGURED)

  textContent      Json?
  errorLog         Json?
  metadata         Json?
  textRequestId    String?
  imageRequestId   String?
  videoRequestId   String?
  videoOperationId String?

  brandDnaVersionId String?
  strategyVersion   Int?
  sourceIds         Json?

  generationSource       String?
  generationInstruction  String?
  parentVersionId        String?
  parentVersion          ContentGeneration?  @relation("VersionHistory", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions          ContentGeneration[] @relation("VersionHistory")

  qualityScore      Json?
  scoringStatus     ScoringStatus @default(NOT_SCORED)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contentItem      ContentItem  @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand            Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  assets           GeneratedAsset[]
  approvals        Approval[]

  @@index([organizationId])
  @@index([brandId])
  @@index([contentItemId])
  @@index([brandDnaVersionId])
}

enum ScoringStatus {
  NOT_SCORED
  SCORING
  SCORED
  FAILED
}

enum GenerationStatus {
  QUEUED
  GENERATING
  COMPLETED
  FAILED
  NOT_CONFIGURED
}

model GeneratedAsset {
  id               String   @id @default(cuid())
  organizationId   String
  brandId          String
  generationId     String
  contentItemId    String
  type             String
  objectKey        String
  mimeType         String?
  url              String?
  provider         String
  model            String
  slideIndex       Int?
  metadata         Json?
  createdAt        DateTime @default(now())

  generation       ContentGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand            Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([brandId])
  @@index([generationId])
  @@index([contentItemId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model Approval {
  id               String         @id @default(cuid())
  organizationId   String
  brandId          String
  contentItemId    String
  contentVersionId String
  status           ApprovalStatus @default(PENDING)
  reason           String?
  requestedById    String
  reviewedById     String?
  requestedAt      DateTime       @default(now())
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand            Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentItem      ContentItem       @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  contentVersion   ContentGeneration @relation(fields: [contentVersionId], references: [id], onDelete: Cascade)
  requestedBy      User              @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  reviewedBy       User?             @relation("ApprovalReviewedBy", fields: [reviewedById], references: [id])

  @@index([organizationId])
  @@index([brandId])
  @@index([contentItemId])
  @@index([contentVersionId])
}
