{
  "name": "worker",
  "projectType": "application",
  "root": "apps/worker",
  "sourceRoot": "apps/worker/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc -p apps/worker/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run apps/worker/src"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx apps/worker/src/main.ts"
      }
    }
  }
}
