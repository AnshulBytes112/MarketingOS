{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@abge/ui": ["../../packages/ui/src/index.ts"],
      "@abge/ui/*": ["../../packages/ui/src/*"],
      "@abge/database": ["../../packages/database/src/index.ts"],
      "@abge/auth": ["../../packages/auth/src/index.ts"],
      "@abge/tenant": ["../../packages/tenant/src/index.ts"],
      "@abge/rbac": ["../../packages/rbac/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
